[Unit]
Description=Home Sanctuary Discord Notifier
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=claude
WorkingDirectory=/opt/home-sanctuary
ExecStart=/usr/bin/node /opt/home-sanctuary/discord-notifier.js
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
